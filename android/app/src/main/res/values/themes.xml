<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="space">#FF02040B</color>

    <!-- Plein écran, fond spatial affiché dès le lancement (avant le chargement de la page). -->
    <style name="Theme.HorlogeCosmique" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/space</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
