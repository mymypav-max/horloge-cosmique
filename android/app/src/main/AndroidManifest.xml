<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      La WebView charge l'application depuis une origine HTTPS locale
      (https://appassets.androidplatform.net/), servie depuis les assets de
      l'APK. La permission INTERNET est déclarée par prudence pour ce mode de
      chargement ; toute requête vers un autre hôte est refusée par
      LocalAssetWebViewClient : l'application ne contacte aucun serveur.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Application de salon : télécommande, pas d'écran tactile requis. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.HorlogeCosmique"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Icône dans « Vos applications et chaînes » du Fire TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
