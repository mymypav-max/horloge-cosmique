{
  "name": "horloge-cosmique",
  "version": "1.0.0",
  "private": true,
  "description": "Horloge astronomique interactive en 3D pour téléviseur (Fire TV Stick) : système solaire aux positions angulaires réelles et Terre éclairée selon l'heure.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-check.mjs",
    "assets:stars": "node scripts/build-stars.mjs",
    "assets:icons": "node scripts/build-android-icons.mjs"
  },
  "dependencies": {
    "@fontsource/jost": "5.3.0",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@types/three": "0.162.0",
    "astronomy-engine": "2.1.19",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
